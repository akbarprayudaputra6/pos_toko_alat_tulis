    {
      "name": "4. Transaksi",
      "description": "Checkout dan riwayat. Harga, total, pemilik, dan nomor invoice **dihitung server**; nilai yang dikirim klien diabaikan.",
      "item": [
        {
          "name": "Checkout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "transactions"
              ]
            },
            "description": "Membuat transaksi dan mengurangi stok secara atomik. Nomor invoice berformat `INV-YYYYMMDD-0001`.\n\n**Gagal:** `422` dengan `{\"message\":\"Transaksi gagal.\",\"errors\":{...}}` bila stok kurang; seluruh perubahan dibatalkan.\n\n**Akses:** login (admin dan kasir).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product_id\": \"{{product_id}}\",\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Transaksi dibuat\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "if (j.data && j.data.id) pm.environment.set(\"transaction_id\", j.data.id);",
                  "pm.test(\"Nomor invoice berformat benar\", () => pm.expect(j.data.invoice_number).to.match(/^INV-\\d{8}-\\d{4}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Riwayat transaksi",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/transactions?page=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "transactions"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "disabled": true
                }
              ]
            },
            "description": "Kasir hanya melihat miliknya, admin melihat semua. Dipaginasi **15 per halaman** (`data`, `total`, `current_page`)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Detail transaksi",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/transactions/{{transaction_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "transactions",
                "{{transaction_id}}"
              ]
            },
            "description": "Pemilik atau admin. **Gagal:** `403`/`404` bila milik kasir lain; `404` untuk id tidak numerik."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
